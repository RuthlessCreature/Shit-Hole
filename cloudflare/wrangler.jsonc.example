{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shit-hole-logic-b",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-23",
  "limits": { "cpu_ms": 300000 },
  "triggers": {
    "crons": ["20 8 * * 1-5"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shit-hole-research",
      "database_id": "REPLACE_WITH_REAL_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "shit-hole-research-raw" }
  ],
  "vars": {
    "MIN_A_COUNT": "5000",
    "MIN_CB_COUNT": "200"
  },
  "observability": { "enabled": true }
}
